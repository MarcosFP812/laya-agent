// The fragment the installer merges into the target OpenCode config
// (project `.opencode/opencode.jsonc` or the global one).
// Placeholder: <COLTEX_BASE_URL>.
//
// The token is NEVER written here — the header references the token file
// through {file:...} substitution, so this fragment stays commit-safe.
//
// There is intentionally NO "skills" entry: the skill source is the global
// clone at ~/.config/opencode/skills/laya, which OpenCode discovers
// automatically. Nothing from this repository is ever copied into the
// target project.
{
  "mcp": {
    "servers": {
      "coltex": {
        "type": "remote",
        "url": "<COLTEX_BASE_URL>/api/mcp",
        "oauth": false,
        // Tools stay plain direct calls (coltex_*), matching the direct-call
        // loop the laya-coltex manual documents. With Code Mode active (the
        // default) they would live behind the `execute` catalog instead.
        "codemode": false,
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/laya-token}"
        }
      }
    }
  },

  // Deny rules for laya-scoped resources. The laya agent re-allows them in
  // its own definition (last matching rule wins), so only laya sees them.
  "permissions": [
    { "action": "coltex_*", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "laya-*", "effect": "deny" }
  ]
}
